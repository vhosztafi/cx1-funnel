{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cx1-dev",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "routes": [{ "pattern": "cx1-dev.gyongyos.co.uk", "custom_domain": true }],
  "preview_urls": false,
  "main": "worker/index.ts",
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "10010910",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application",
  },
}
